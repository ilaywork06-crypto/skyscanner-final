{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node", "vite/client", "unplugin-vue-router/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@truth-platform/ag-grid-ts": ["../../packages/ag-grid-ts/src/index.ts"],
      "@truth-platform/core-ui": ["../../packages/core-ui/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/typed-router.d.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "../../packages/ag-grid-ts/src/**/*.ts",
    "../../packages/core-ui/src/**/*.ts",
    "../../packages/core-ui/src/**/*.vue"
  ]
}
